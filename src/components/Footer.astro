<footer class="bg-black text-white pt-16 pb-12 border-t border-white/10 relative z-10">
  <div class="container mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-12">
      <div class="lg:col-span-2">
        <a href="/" class="inline-block mb-6">
          <img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png" alt="EUROCERT Logo" class="h-16 w-auto" />
        </a>
        <p class="text-white/60 text-sm leading-relaxed mb-6 max-w-sm">
          Eurocert Asia — Independent certification, inspection, CE marking, and compliance partner for global businesses. ISO, GFSI, Social Audits & Sustainability.
        </p>
        <div class="flex items-center space-x-4 text-white/70">
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-eurogold-400 transition" aria-label="LinkedIn"><i class="fab fa-linkedin text-lg"></i></a>
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="hover:text-eurogold-400 transition" aria-label="Facebook"><i class="fab fa-facebook text-lg"></i></a>
