          <a href="mailto:info@eurocert.in" class="hover:text-eurogold-400 transition" aria-label="Email"><i class="fas fa-envelope text-lg"></i></a>
        </div>
      </div>

      <div>
        <h4 class="heading-font text-xs text-eurogold-400 uppercase tracking-widest font-bold mb-4">Services</h4>
        <ul class="space-y-2.5 text-xs text-white/70">
          <li><a href="/ce-certification" class="hover:text-white transition">CE Marking</a></li>
          <li><a href="/food-certification" class="hover:text-white transition">Food Safety (FSSC / BRC / ISO 22000)</a></li>
          <li><a href="/social-audits" class="hover:text-white transition">Social Audits (SEDEX / SA8000)</a></li>
          <li><a href="/management-systems" class="hover:text-white transition">Management Systems (ISO 9001 / 14001)</a></li>
          <li><a href="/sustainability" class="hover:text-white transition">Sustainability & ESG (ISO 14064 / LCA)</a></li>
          <li><a href="/training" class="hover:text-white transition">Training & FoSTaC</a></li>
        </ul>
      </div>

      <div>
        <h4 class="heading-font text-xs text-eurogold-400 uppercase tracking-widest font-bold mb-4">Quick Links</h4>
        <ul class="space-y-2.5 text-xs text-white/70">
          <li><a href="/about" class="hover:text-white transition">About Us</a></li>
          <li><a href="/accreditations" class="hover:text-white transition">Accreditations</a></li>
          <li><a href="/certified-clients" class="hover:text-white transition">Certified Clients Directory</a></li>
          <li><a href="/contact" class="hover:text-white transition">Contact Us</a></li>
          <li><a href="/grievance" class="hover:text-white transition">Grievance / Appeal</a></li>
          <li><a href="/privacy-policy" class="hover:text-white transition">Privacy Policy</a></li>
        </ul>
      </div>

      <div>
        <h4 class="heading-font text-xs text-eurogold-400 uppercase tracking-widest font-bold mb-4">Contact Info</h4>
        <ul class="space-y-3 text-xs text-white/70">
          <li class="flex items-start">
            <i class="fas fa-map-marker-alt text-eurogold-400 mt-0.5 mr-2 shrink-0"></i>
            <span>Panchkula, Haryana, India</span>
          </li>
          <li class="flex items-center">
            <i class="fas fa-phone text-eurogold-400 mr-2 shrink-0"></i>
            <a href="tel:+919316012883" class="hover:text-white">+91 9316012883</a>
          </li>
          <li class="flex items-center">
            <i class="fas fa-envelope text-eurogold-400 mr-2 shrink-0"></i>
